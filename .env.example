PORT=3001
NODE_ENV=development
DATABASE_URL="file:./dev.db"
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=86400
BCRYPT_ROUNDS=10
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080,http://127.0.0.1:3000
API_PUBLIC_URL=http://localhost:3001
FRONTEND_URL=http://localhost:8080
UPLOAD_DIR=uploads
MAX_PHOTO_BYTES=5242880
# false = cadastro devolve token e o login não exige e-mail confirmado
REQUIRE_EMAIL_CONFIRMATION=false
EMAIL_CONFIRM_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
SEED_ON_BOOT=true
PIX_SIMULADO_PAGO_EM_SEGUNDOS=5
PIX_TTL_MINUTOS=30

# SMTP opcional. Sem SMTP_HOST, o e-mail é impresso no console.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="GoGuia <noreply@goguia.test>"
