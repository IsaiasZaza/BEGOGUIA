{
  "name": "goguia-api",
  "version": "1.0.0",
  "private": true,
    "description": "API do GoGuia",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "setup": "prisma db push && tsx src/seed.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx src/seed.ts",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "pretest": "cross-env DATABASE_URL=file:./test.db prisma db push --skip-generate --accept-data-loss",
    "test": "cross-env DATABASE_URL=file:./test.db JWT_SECRET=test-secret BCRYPT_ROUNDS=4 MAX_PHOTO_BYTES=2048 UPLOAD_DIR=uploads-test REQUIRE_EMAIL_CONFIRMATION=false API_PUBLIC_URL=http://localhost:3001 FRONTEND_URL=http://localhost:8080 node --test-concurrency=1 --import tsx --test tests/auth.test.ts tests/domain.test.ts tests/plataforma.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "~4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "qrcode": "^1.5.4",
    "nodemailer": "^6.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.17",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "cross-env": "^7.0.3",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
